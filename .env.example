# Copy to .env and edit. Only the admin account is required; other keys can be set later in the web UI (Quản trị).
BONRS_ADMIN_EMAIL=admin@example.org
BONRS_ADMIN_PASSWORD=change-me-to-a-long-password   # only used on the first start; change it later in Tài khoản
# ANTHROPIC_API_KEY=sk-ant-...        # or set it in the web UI; jobs never see it (they get a short-lived proxy token)
# BONRS_PORT=8765
# BONRS_SECURE_COOKIE=1               # force Secure cookies (automatic when the proxy forwards https)
