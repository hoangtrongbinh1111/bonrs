#!/usr/local/bin/python3 -IS
"""Root helper, called only by the server user through sudo (see Dockerfile):

    sudo -n /usr/local/sbin/bonrs-sandbox <uid> <spec.json>

Hands a tenant's folders to that tenant's uid, then runs one command as that uid (never as root).
The spec file is written by the server into DATA/.sandbox (mode 700) and deleted here:
    {"chown": [abs dirs], "cwd": abs dir, "argv": [...], "env": {...}, "timeout": seconds}
Allowed chown roots: DATA/runs/<slug> and DATA/tenants/<uid> of this same uid.
"""
import fcntl, json, os, re, resource, signal, stat, sys, time

DATA = "/data"
SERVER_UID = 1000
SPECDIR = os.path.join(DATA, ".sandbox")
NOFOLLOW_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def die(msg, code=126):
    print(f"bonrs-sandbox: {msg}", file=sys.stderr); sys.exit(code)


def load_spec(path):
    path = os.path.abspath(path)
    if os.path.dirname(path) != SPECDIR or not re.fullmatch(r"[A-Za-z0-9_-]{8,80}\.json", os.path.basename(path)): die("bad spec path")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != SERVER_UID or st.st_nlink != 1 or st.st_size > 1_000_000: die("bad spec file")
    with os.fdopen(fd) as f: spec = json.load(f)
    os.unlink(path)
    return spec


def allowed_root(p, uid):
    runs, tenants = os.path.join(DATA, "runs"), os.path.join(DATA, "tenants", str(uid))
    if p == tenants: return True
    head, slug = os.path.split(p)
    return head == runs and re.fullmatch(r"[a-z0-9][a-z0-9-]{0,80}", slug) is not None


def open_root(p):
    """Open an allowed root without following symlinks at any component (its parents are server-owned)."""
    fd = os.open("/", NOFOLLOW_DIR)
    for part in [x for x in p.split("/") if x]:
        try: nfd = os.open(part, NOFOLLOW_DIR, dir_fd=fd)
        finally: os.close(fd)
        fd = nfd
    return fd


def _in_ssh(root, top): rel = top[len(root):]; return rel == "/ssh" or rel.startswith("/ssh/")


def hand_over(root, uid):
    """Give the tree to uid:server-group. fd-relative and no-follow throughout: a tenant swapping a
    directory for a symlink, or hard-linking a foreign file, cannot redirect chown/chmod."""
    rfd = open_root(root)
    try:
        st = os.fstat(rfd)
        if st.st_uid not in (0, SERVER_UID, uid): die(f"{root}: unexpected owner")
        os.fchown(rfd, uid, SERVER_UID); os.fchmod(rfd, 0o2770)
    finally: os.close(rfd)
    for top, dirs, files, dfd in os.fwalk(root, follow_symlinks=False):
        keep_mode = _in_ssh(root, top)  # private keys must stay 0600
        for name in dirs + files:
            try: fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
            except OSError: continue  # symlink, fifo, vanished: leave it alone
            try:
                st = os.fstat(fd)
                if st.st_uid not in (SERVER_UID, uid): continue  # never touch anyone else's file
                if stat.S_ISREG(st.st_mode):
                    if st.st_nlink != 1: continue
                    os.fchown(fd, uid, SERVER_UID)
                    if not keep_mode: os.fchmod(fd, (st.st_mode & 0o700) | ((st.st_mode & 0o700) >> 3) | 0o060)
                elif stat.S_ISDIR(st.st_mode):
                    os.fchown(fd, uid, SERVER_UID)
                    if not keep_mode or name == "ssh": os.fchmod(fd, 0o2770)
            finally: os.close(fd)


def group_readable(root):
    """After the job (already running as the tenant): let the server read what the tenant wrote. fd-based, no-follow."""
    for top, dirs, files, dfd in os.fwalk(root, follow_symlinks=False):
        if _in_ssh(root, top): continue
        for name in dirs + files:
            try: fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
            except OSError: continue
            try:
                st = os.fstat(fd)
                if st.st_uid == os.getuid() and (st.st_mode & 0o040) == 0 and (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
                    os.fchmod(fd, stat.S_IMODE(st.st_mode) | 0o040 | (0o010 if stat.S_ISDIR(st.st_mode) else 0))
            except OSError: pass
            finally: os.close(fd)


def ensure_account(uid):
    """ssh/ssh-keygen need a passwd entry for the uid: add a login-less one (no password, nologin shell) once."""
    name = f"t{uid}"
    for path, line in (("/etc/group", f"{name}:x:{uid}:\n"),
                       ("/etc/passwd", f"{name}:x:{uid}:{uid}:bonrs user:{DATA}/tenants/{uid}/home:/usr/sbin/nologin\n")):
        with open(path, "r+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            if not any(len(l.split(":")) > 3 and l.split(":")[2] == str(uid) for l in f):
                f.seek(0, 2); f.write(line)


def _alive(pid):
    try: os.kill(pid, 0); return True
    except OSError: return False


def main():
    if os.geteuid() != 0: die("must run as root via sudo")
    if len(sys.argv) != 3: die("usage: bonrs-sandbox <uid> <spec.json>")
    uid = int(sys.argv[1])
    if not 20000 <= uid < 2 ** 31 - 2: die("uid out of tenant range")
    spec = load_spec(sys.argv[2])
    ensure_account(uid)
    roots = [os.path.normpath(p) for p in spec.get("chown", [])]
    for r in roots:
        if not allowed_root(r, uid): die(f"chown root not allowed: {r}")
        if os.path.lexists(r): hand_over(r, uid)
    argv, env, cwd = spec.get("argv"), {str(k): str(v) for k, v in (spec.get("env") or {}).items()}, spec.get("cwd") or "/"
    if not argv or not isinstance(argv, list): die("empty argv")
    os.setgroups([]); os.setgid(uid); os.setuid(uid)  # drop to the tenant for good
    if os.getuid() != uid or os.geteuid() != uid or os.getgid() != uid: die("setuid failed")
    import ctypes
    if ctypes.CDLL(None, use_errno=True).prctl(38, 1, 0, 0, 0) != 0: die("cannot set no_new_privs")  # PR_SET_NO_NEW_PRIVS
    os.umask(0o007)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    resource.setrlimit(resource.RLIMIT_NPROC, (int(spec.get("nproc", 512)),) * 2)
    resource.setrlimit(resource.RLIMIT_FSIZE, (int(spec.get("fsize", 8 << 30)),) * 2)
    if spec.get("cpu"): resource.setrlimit(resource.RLIMIT_CPU, (int(spec["cpu"]),) * 2)  # short commands: bounded CPU per process
    os.chdir(cwd)
    child = os.fork()
    if child == 0:
        os.setsid()
        try: os.execvpe(argv[0], [str(a) for a in argv], env)
        except OSError as e: print(f"bonrs-sandbox: exec {argv[0]}: {e}", file=sys.stderr); os._exit(127)

    def stop(*_):
        if _alive(child):
            try: os.killpg(child, signal.SIGTERM)
            except OSError: pass
    signal.signal(signal.SIGTERM, stop); signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGHUP, stop)
    deadline = time.time() + float(spec["timeout"]) if spec.get("timeout") else None
    status = 0
    while True:
        try: pid, status = os.waitpid(child, os.WNOHANG)
        except ChildProcessError: break
        if pid: break
        if deadline and time.time() > deadline:
            print("bonrs-sandbox: time limit reached, stopping job", file=sys.stderr); stop(); deadline = None
            if spec.get("reap"):
                time.sleep(5)
                try: os.kill(-1, signal.SIGKILL)
                except OSError: pass
        time.sleep(0.3)
    if spec.get("reap"):  # long job, the tenant's only one: nothing it started may outlive it (setsid'd daemons included)
        try: os.kill(-1, signal.SIGKILL)  # as the tenant: every process of this uid except this helper
        except OSError: pass
    for r in roots:
        if os.path.isdir(r): group_readable(r)
    code = os.waitstatus_to_exitcode(status)
    sys.exit(code if code >= 0 else 128 - code)


if __name__ == "__main__":
    main()
